---
import Base from '../../layouts/Base.astro';
---
<Base title="Espace adhérents" admin={true}>
  <div class="contenu" style="padding:22px 20px 60px;max-width:1200px">
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
      <h1 style="margin:0">Adhérents — Le Tinal</h1>
      <span id="pastille" class="pill a_regler" hidden></span>
      <button id="deconnexion" class="bouton secondaire" style="margin-left:auto" hidden>Déconnexion</button>
    </div>

    <!-- Connexion -->
    <form id="form-login" class="adhesion" style="margin-top:24px;max-width:420px">
      <div class="champ">
        <label for="token">Code d'accès administrateur</label>
        <input id="token" type="password" autocomplete="current-password" placeholder="Votre code secret" />
        <p class="aide">Code défini dans les réglages Cloudflare (ADMIN_TOKEN).</p>
      </div>
      <p id="login-err" style="color:var(--alerte);font-weight:600" hidden></p>
      <button class="bouton" type="submit">Accéder</button>
    </form>

    <!-- Tableau -->
    <div id="zone" hidden>
      <div class="cartes" style="margin:20px 0">
        <div class="carte"><h3 id="stat-total">0</h3><p>adhérents</p></div>
        <div class="carte"><h3 id="stat-payes" style="color:var(--ok)">0</h3><p>à jour de cotisation</p></div>
        <div class="carte"><h3 id="stat-attente" style="color:#92600e">0</h3><p>à régler</p></div>
        <div class="carte"><h3 id="stat-montant">0 €</h3><p>encaissé</p></div>
      </div>

      <div class="barre-outils">
        <input id="recherche" placeholder="Rechercher (nom, e-mail, ville)…" style="flex:1;min-width:200px;padding:10px 12px;border:1px solid var(--bord-champ);border-radius:10px" />
        <select id="filtre-saison" style="padding:10px;border:1px solid var(--bord-champ);border-radius:10px"></select>
        <select id="filtre-statut" style="padding:10px;border:1px solid var(--bord-champ);border-radius:10px">
          <option value="">Tous les statuts</option>
          <option value="paye">À jour</option>
          <option value="a_regler">À régler</option>
          <option value="annule">Annulé</option>
        </select>
        <button id="btn-ajouter" class="bouton secondaire">+ Ajouter</button>
        <a id="btn-export" class="bouton" href="#">Exporter (CSV)</a>
      </div>

      <div class="table-wrap">
        <table class="inscrits">
          <thead>
            <tr>
              <th>Nom</th><th>E-mail</th><th>Tél.</th><th>Ville</th><th>Saison</th>
              <th>Montant</th><th>Statut</th><th>Inscrit le</th><th></th>
            </tr>
          </thead>
          <tbody id="corps"></tbody>
        </table>
      </div>
      <p id="vide" class="aide" hidden style="margin-top:16px">Aucun adhérent pour ces filtres.</p>
    </div>
  </div>

  <script is:inline>
    const CLE = 'tinal_admin_token';
    let TOKEN = localStorage.getItem(CLE) || '';
    let DATA = [];

    const $ = (id) => document.getElementById(id);
    const euro = (n) => (Math.round((+n || 0) * 100) / 100).toLocaleString('fr-FR') + ' €';
    const dateFr = (s) => s ? new Date(s.replace(' ', 'T') + 'Z').toLocaleDateString('fr-FR') : '';
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

    async function api(path, opts = {}) {
      const r = await fetch(path, {
        ...opts,
        headers: { 'Authorization': 'Bearer ' + TOKEN, 'Content-Type': 'application/json', ...(opts.headers || {}) },
      });
      return r;
    }

    async function charger() {
      const r = await api('/api/adherents');
      if (r.status === 401) { deconnexion(true); return; }
      const j = await r.json();
      DATA = j.adherents || [];
      majSaisons();
      rendre();
      $('form-login').hidden = true;
      $('zone').hidden = false;
      $('deconnexion').hidden = false;
      $('pastille').hidden = false;
      $('pastille').textContent = DATA.length + ' au total';
      $('pastille').className = 'pill paye';
    }

    function majSaisons() {
      const sel = $('filtre-saison');
      const saisons = [...new Set(DATA.map(a => a.saison))].sort().reverse();
      const cur = sel.value;
      sel.innerHTML = '<option value="">Toutes saisons</option>' + saisons.map(s => `<option value="${s}">Saison ${s}</option>`).join('');
      sel.value = cur;
    }

    function filtres(a) {
      const q = $('recherche').value.trim().toLowerCase();
      const s = $('filtre-saison').value;
      const st = $('filtre-statut').value;
      if (s && a.saison !== s) return false;
      if (st && a.statut !== st) return false;
      if (q) {
        const blob = `${a.prenom} ${a.nom} ${a.email} ${a.ville}`.toLowerCase();
        if (!blob.includes(q)) return false;
      }
      return true;
    }

    function rendre() {
      const vue = DATA.filter(filtres);
      const total = vue.length;
      const payes = vue.filter(a => a.statut === 'paye');
      const attente = vue.filter(a => a.statut === 'a_regler');
      const montant = payes.reduce((s, a) => s + (+a.montant_eur || 0), 0);
      $('stat-total').textContent = total;
      $('stat-payes').textContent = payes.length;
      $('stat-attente').textContent = attente.length;
      $('stat-montant').textContent = euro(montant);
      $('vide').hidden = total !== 0;

      $('corps').innerHTML = vue.map(a => {
        const st = a.statut === 'paye' ? 'paye' : (a.statut === 'annule' ? 'annule' : 'a_regler');
        const label = st === 'paye' ? 'À jour' : (st === 'annule' ? 'Annulé' : 'À régler');
        const action = a.statut === 'paye'
          ? `<button data-id="${a.id}" data-statut="a_regler" class="chg bouton secondaire" style="padding:5px 12px">Marquer à régler</button>`
          : `<button data-id="${a.id}" data-statut="paye" class="chg bouton" style="padding:5px 12px">Marquer payé</button>`;
        return `<tr>
          <td><strong>${esc(a.nom)}</strong> ${esc(a.prenom)}</td>
          <td>${esc(a.email)}</td>
          <td>${esc(a.telephone)}</td>
          <td>${esc(a.ville)}</td>
          <td>${esc(a.saison)}</td>
          <td>${euro(a.montant_eur)}</td>
          <td><span class="pill ${st}">${label}</span></td>
          <td>${dateFr(a.cree_le)}</td>
          <td>${action}</td>
        </tr>`;
      }).join('');

      document.querySelectorAll('.chg').forEach(b => b.addEventListener('click', async () => {
        b.disabled = true;
        const r = await api('/api/statut', { method: 'POST', body: JSON.stringify({ id: +b.dataset.id, statut: b.dataset.statut, moyen: b.dataset.statut === 'paye' ? 'sur_place' : null }) });
        if (r.ok) { const a = DATA.find(x => x.id == b.dataset.id); if (a) a.statut = b.dataset.statut; rendre(); }
        else b.disabled = false;
      }));
    }

    function deconnexion(auto) {
      TOKEN = ''; localStorage.removeItem(CLE);
      $('zone').hidden = true; $('deconnexion').hidden = true; $('pastille').hidden = true;
      $('form-login').hidden = false;
      if (auto) { $('login-err').textContent = 'Session expirée ou code invalide.'; $('login-err').hidden = false; }
    }

    $('form-login').addEventListener('submit', async (e) => {
      e.preventDefault();
      TOKEN = $('token').value.trim();
      $('login-err').hidden = true;
      const r = await api('/api/adherents');
      if (r.status === 401) { $('login-err').textContent = 'Code invalide.'; $('login-err').hidden = false; return; }
      localStorage.setItem(CLE, TOKEN);
      await charger();
    });

    ['recherche','filtre-saison','filtre-statut'].forEach(id => $(id).addEventListener('input', rendre));
    $('deconnexion').addEventListener('click', () => deconnexion(false));
    $('btn-export').addEventListener('click', (e) => {
      e.preventDefault();
      const s = $('filtre-saison').value;
      window.location.href = `/api/export?token=${encodeURIComponent(TOKEN)}${s ? '&saison=' + s : ''}`;
    });
    $('btn-ajouter').addEventListener('click', async () => {
      const prenom = prompt('Prénom ?'); if (!prenom) return;
      const nom = prompt('Nom ?'); if (!nom) return;
      const email = prompt('E-mail ?'); if (!email) return;
      const r = await fetch('/api/adhesion', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ prenom, nom, email, ville: 'Ouveillan', rgpd: true }) });
      if (r.ok) charger(); else alert("Ajout impossible (adhérent déjà présent pour cette saison ?)");
    });

    if (TOKEN) charger();
  </script>
</Base>
