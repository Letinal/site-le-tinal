---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import prog from '../data/programme.json';
const moisCourt = ['janv.','févr.','mars','avr.','mai','juin','juil.','août','sept.','oct.','nov.','déc.'];
const aujourdhui = new Date().toISOString().slice(0,10);
const prochains = prog.evenements
  .filter(e => e.date >= aujourdhui)
  .sort((a,b) => a.date.localeCompare(b.date))
  .slice(0,3);
const liste = prochains.length ? prochains : prog.evenements.slice(0,3);
function jour(d){ return new Date(d).getDate(); }
function mois(d){ return moisCourt[new Date(d).getMonth()]; }
---
<Base>
  <section class="hero">
    <div class="contenu">
      <h1>{site.nom}</h1>
      <p class="baseline">{site.baseline}. {site.objet}</p>
      <div class="actions">
        <a class="bouton" href="/adherer">Adhérer en ligne</a>
        <a class="bouton secondaire" href="/programme">Voir le programme</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="contenu">
      <h2>{site.saisonLabel} {site.saisonAnnee}</h2>
      <p>Une saison de rendez-vous culturels et conviviaux au cœur du village. Voici les prochains :</p>
      {liste.map(e => (
        <article class="evt">
          <div class="cal"><div class="j">{jour(e.date)}</div><div class="m">{mois(e.date)}</div></div>
          <div>
            <h3>{e.titre}{e.gratuit && <span class="badge gratuit">Gratuit</span>}</h3>
            <div class="meta">{e.type} · {e.heure} · {e.lieu}</div>
            <p>{e.description}</p>
          </div>
        </article>
      ))}
      <p style="margin-top:18px"><a class="bouton secondaire" href="/programme">Toute la saison &rarr;</a></p>
    </div>
  </section>

  <section class="section">
    <div class="contenu">
      <div class="cartes">
        <div class="carte">
          <h3>Un lieu de vie</h3>
          <p>{site.objet}</p>
        </div>
        <div class="carte">
          <h3>Devenir adhérent</h3>
          <p>{site.cotisationTexte} Adhésion {site.cotisationEur} € / an.</p>
          <p><a class="bouton" href="/adherer">Adhérer</a></p>
        </div>
        <div class="carte">
          <h3>Nous trouver</h3>
          <p>{site.adresse}</p>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
      </div>
    </div>
  </section>
</Base>
