---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import prog from '../data/programme.json';
const moisCourt = ['janv.','févr.','mars','avr.','mai','juin','juil.','août','sept.','oct.','nov.','déc.'];
const evts = [...prog.evenements].sort((a,b) => a.date.localeCompare(b.date));
function jour(d){ return new Date(d).getDate(); }
function mois(d){ return moisCourt[new Date(d).getMonth()]; }
function dateLongue(d){ return new Date(d).toLocaleDateString('fr-FR', { weekday:'long', day:'numeric', month:'long', year:'numeric' }); }
---
<Base title="Programme" description={`Programme de la saison ${prog.annee} de l'association Le Tinal à Ouveillan.`}>
  <section class="section" style="padding-top:40px">
    <div class="contenu">
      <h1>Programme {prog.annee}</h1>
      <p>{site.saisonLabel}. Entrée libre sauf mention contraire. Programme susceptible d'évoluer.</p>
      {evts.map(e => (
        <article class="evt">
          <div class="cal"><div class="j">{jour(e.date)}</div><div class="m">{mois(e.date)}</div></div>
          <div>
            <h3>{e.titre}
              {e.gratuit ? <span class="badge gratuit">Gratuit</span> : (e.prix && <span class="badge">{e.prix}</span>)}
            </h3>
            <div class="meta">{dateLongue(e.date)} · {e.heure} · {e.type} · {e.lieu}</div>
            <p>{e.description}</p>
          </div>
        </article>
      ))}
      <div class="encart">
        <strong>Envie de ne rien manquer&nbsp;?</strong> Adhérez à l'association&nbsp;: vous soutenez la programmation et recevez les informations de la saison.
        <p style="margin:12px 0 0"><a class="bouton" href="/adherer">Adhérer</a></p>
      </div>
    </div>
  </section>
</Base>
