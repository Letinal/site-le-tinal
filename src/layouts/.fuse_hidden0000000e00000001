---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
const { title, description, admin = false } = Astro.props;
const titreComplet = title ? `${title} — ${site.nom}` : `${site.nomComplet} — ${site.baseline}`;
const desc = description ?? site.objet;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titreComplet}</title>
  <meta name="description" content={desc} />
  <meta name="theme-color" content="#3f5d47" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta property="og:title" content={titreComplet} />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content="website" />
</head>
<body>
  {!admin && <Header />}
  <main>
    <slot />
  </main>
  {!admin && <Footer />}
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
    }
  </script>
</body>
</html>
