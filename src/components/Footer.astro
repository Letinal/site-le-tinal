---
import site from '../data/site.json';
import fs from 'node:fs';
const partDir = 'public/partenaires';
const partenaires = fs.existsSync(partDir)
  ? fs.readdirSync(partDir).filter(x=>/\.(png|jpe?g|svg|webp)$/i.test(x)).sort((a,b)=>a.localeCompare(b,'fr',{numeric:true}))
  : [];
const telHref = 'tel:+' + (site.whatsapp?.replace(/\D/g, '') || '');
---
<footer class="site-footer">
  <div class="contenu">
    <div class="cols">
      <div>
        <h4>{site.nomComplet}</h4>
        <p>{site.objet}</p>
      </div>
      <div>
        <h4>Contact</h4>
        <p>
          {site.adresse}<br/>
          {site.telephone && <><a href={telHref}>{site.telephone}</a> · <a href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a><br/></>}
          <a href={site.instagram} target="_blank" rel="noopener"><strong>Instagram</strong></a> · <a href={site.facebook} target="_blank" rel="noopener">Facebook</a>
        </p>
      </div>
      <div>
        <h4>Adhérer</h4>
        <p>Rejoignez l'association — adhésion à montant libre — et faites vivre la culture au village.</p>
        <a class="bouton" href="/adherer">Devenir adhérent</a>
      </div>
    </div>
    {partenaires.length > 0 && (
      <div class="partenaires">
        <h4>Avec le soutien de</h4>
        <div class="partenaires-logos">
          {partenaires.map(p => <img src={`/partenaires/${p}`} alt="Partenaire du Tinal" loading="lazy" />)}
        </div>
      </div>
    )}
    <div class="bas">
      {site.loi1901} · <a href="/mentions-legales">Mentions légales</a> · &copy; {new Date().getFullYear()} {site.nomComplet}
    </div>
  </div>
</footer>
