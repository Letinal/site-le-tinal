# Copiez ce fichier en ".dev.vars" pour le developpement local (npm run dev).
# En production, definissez ces valeurs dans le dashboard Cloudflare.

# --- Espace admin (tableau des inscrits) ---
# Mot de passe/jeton unique pour acceder a l'espace admin. Mettez une longue phrase secrete.
ADMIN_TOKEN="changez-moi-avec-une-longue-phrase-secrete"

# --- Paiement SumUp (adhesion en ligne) ---
# Laissez vide pour demarrer : l'adhesion fonctionnera en mode "a regler sur place".
# Cle API SumUp (dashboard SumUp > Developpeurs). A garder cote serveur uniquement.
SUMUP_API_KEY=""
# Code marchand SumUp (merchant code), visible dans le profil du compte SumUp.
SUMUP_MERCHANT_CODE=""
# Secret pour verifier les webhooks SumUp (optionnel selon config).
SUMUP_WEBHOOK_SECRET=""

# Montant de l'adhesion en euros (peut aussi etre gere dans src/data/site.json)
COTISATION_EUR="10"
